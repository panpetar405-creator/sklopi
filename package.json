{
  "name": "sklopi",
  "private": true,
  "description": "SKLOPI — statički sajt. Skripte za prevode: vidi PREVODI.md",
  "scripts": {
    "i18n": "node translate.mjs",
    "i18n:check": "node translate.mjs --check",
    "i18n:build": "node translate.mjs --build",
    "i18n:test": "node selftest.mjs",
    "i18n:todo": "node find-hardcoded.mjs",
    "check:assets": "node check-assets.mjs",
    "fetch:images": "node fetch-missing-images.mjs",
    "fetch:fonts": "node fetch-fonts.mjs",
    "stamp": "node stamp-assets.mjs",
    "stamp:check": "node stamp-assets.mjs --check",
    "sitemap": "node generate-sitemap.mjs",
    "sitemap:check": "node generate-sitemap.mjs --check",
    "predeploy": "npm run stamp && npm run sitemap && npm run check:assets"
  },
  "engines": {
    "node": ">=18"
  }
}
